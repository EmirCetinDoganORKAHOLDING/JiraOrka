<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Tezgah" : "Tezgah")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "has-sidebar" : "")">

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/" class="brand-link">
                <img src="~/images/logo.png" alt="WORKAI" class="brand-logo" />
            </a>
            <button class="sidebar-toggle d-lg-none" id="sidebarToggle">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">
                @(User.FindFirst("FullName")?.Value?.FirstOrDefault().ToString().ToUpper() ?? "U")
            </div>
            <div class="user-info">
                <div class="user-name">@User.FindFirst("FullName")?.Value</div>
                <div class="user-role">
                    @if (User.HasClaim("IsSuperAdmin", "true"))
                    {
                        <span class="badge bg-warning text-dark">Süper Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@(User.FindFirst("GroupName")?.Value ?? "Grup Yok")</span>
                    }
                </div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">Ana Menü</div>
                <a href="/Home/Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/Board/Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Board" ? "active" : "")">
                    <i class="bi bi-kanban"></i>
                    <span>Kanban Board</span>
                </a>
                <a href="/Projects/Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                    <i class="bi bi-folder2-open"></i>
                    <span>Projeler</span>
                </a>
                <a href="/Tasks/Create" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                    <i class="bi bi-plus-circle"></i>
                    <span>Yeni Görev</span>
                </a>
            </div>

            @if (User.HasClaim("IsSuperAdmin", "true"))
            {
                <div class="nav-section">
                    <div class="nav-section-title">Yönetim</div>
                    <a href="/Admin/Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Admin Panel</span>
                    </a>
                    <a href="/Admin/Users" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Kullanıcılar</span>
                    </a>
                    <a href="/Admin/Groups" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Groups" ? "active" : "")">
                        <i class="bi bi-shield-check"></i>
                        <span>Yetki Grupları</span>
                    </a>
                    <a href="/Projects/Create" class="nav-item">
                        <i class="bi bi-folder-plus"></i>
                        <span>Yeni Proje</span>
                    </a>
                </div>
            }
        </div>

        <div class="sidebar-footer">
            <a href="/Account/Profile" class="nav-item">
                <i class="bi bi-person-gear"></i>
                <span>Profil</span>
            </a>
            <form method="post" action="/Account/Logout" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item w-100 text-start border-0 bg-transparent text-danger-soft">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Çıkış Yap</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- Mobile overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main content -->
    <div class="main-wrapper">
        <header class="topbar d-lg-none">
            <button class="btn btn-link p-0 me-3" id="mobileMenuBtn">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a href="/" class="brand-link-mobile">
                <i class="bi bi-kanban-fill text-primary me-1"></i>
                <strong>Tezgah</strong>
            </a>
        </header>

        <main class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

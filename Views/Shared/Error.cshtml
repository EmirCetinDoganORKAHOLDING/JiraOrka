@{
    ViewData["Title"] = "Hata";
    Layout = "_Layout";
}

<div class="py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>
        <div>
            <h2 class="mb-0">Bir hata oluştu</h2>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorPath as string))
            {
                <p class="text-muted mb-0 small">Sayfa: @ViewBag.ErrorPath</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger">
            <strong>Hata:</strong> @ViewBag.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.StackTrace as string))
    {
        <details class="mb-4">
            <summary class="text-muted small" style="cursor:pointer;">Teknik Detay</summary>
            <pre class="mt-2 p-3 bg-light border rounded small" style="overflow:auto;max-height:400px;">@ViewBag.StackTrace</pre>
        </details>
    }

    <a href="/" class="btn btn-primary">
        <i class="bi bi-house me-2"></i>Ana Sayfaya Dön
    </a>
</div>

@{
    ViewData["Title"] = "Dashboard";
    var myTasks  = ViewBag.MyTasks  as List<Tezgah.Models.TaskItem> ?? new();
    var projects = ViewBag.Projects as List<Tezgah.Models.Project>  ?? new();
    var allUsers = ViewBag.AllUsers as List<Tezgah.Models.AppUser>;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Merhaba, @User.FindFirst("FullName")?.Value?.Split(' ')[0] 👋</h2>
        <p class="text-muted mb-0">İşte günün özeti</p>
    </div>
    <a href="/Tasks/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Yeni Görev
    </a>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-list-task"></i></div>
            <div class="stat-value">@ViewBag.TotalTasks</div>
            <div class="stat-label">Toplam Görev</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-value">@ViewBag.OpenTasks</div>
            <div class="stat-label">Açık Görev</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            <div class="stat-value">@ViewBag.DoneTasks</div>
            <div class="stat-label">Tamamlanan</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-folder2"></i></div>
            <div class="stat-value">@ViewBag.TotalProjects</div>
            <div class="stat-label">Proje</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Projects — tam genişlik -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h6 class="fw-bold mb-0"><i class="bi bi-folder2-open me-2 text-purple"></i>Projeler</h6>
                <a href="/Projects/Index" class="btn btn-sm btn-outline-secondary">Tümü</a>
            </div>
            <div class="card-body px-4 pb-4">
                @if (!projects.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-folder-x"></i>
                        <p>Henüz proje yok</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var proj in projects)
                        {
                            <div class="col-md-6 col-lg-4">
                                <a href="/Board/Index?projectId=@proj.Id" class="project-card-small">
                                    <div class="project-key-badge">@(proj.Key ?? proj.Name.Substring(0, Math.Min(3, proj.Name.Length)).ToUpper())</div>
                                    <div class="project-info">
                                        <div class="project-name">@proj.Name</div>
                                        <div class="project-stats text-muted small">
                                            @proj.OpenTaskCount açık / @proj.TaskCount toplam görev
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (allUsers != null && allUsers.Any())
{
    <div class="d-flex align-items-center justify-content-between mt-4 mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Tüm Kullanıcılar</h5>
        <a href="/Admin/Users" class="btn btn-outline-primary btn-sm">Yönet</a>
    </div>
    <div class="row g-3">
        @foreach (var u in allUsers)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a href="/Admin/UserKanban/@u.Id" class="text-decoration-none">
                    <div class="card border-0 shadow-sm hover-card h-100">
                        <div class="card-body p-3 d-flex align-items-center gap-2">
                            <div class="table-avatar flex-shrink-0 @(u.IsSuperAdmin ? "bg-warning text-dark" : "")"
                                 style="width:36px;height:36px;font-size:.9rem;">
                                @u.FullName.FirstOrDefault().ToString().ToUpper()
                            </div>
                            <div class="overflow-hidden">
                                <div class="fw-semibold text-dark small text-truncate">@u.FullName</div>
                                <div class="text-muted" style="font-size:.7rem;">
                                    @if (u.IsSuperAdmin)
                                    {
                                        <span><i class="bi bi-star-fill text-warning"></i> Admin</span>
                                    }
                                    else
                                    {
                                        @(u.GroupName ?? "—")
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

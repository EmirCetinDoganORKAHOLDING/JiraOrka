@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Profil";
}

<div class="page-header">
    <h2 class="page-title"><i class="bi bi-person-circle me-2 text-primary"></i>Profilim</h2>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="profile-avatar mx-auto mb-3">
                    @(User.FindFirst("FullName")?.Value?.FirstOrDefault().ToString().ToUpper())
                </div>
                <h5 class="fw-bold mb-1">@User.FindFirst("FullName")?.Value</h5>
                <p class="text-muted small mb-2">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                @if (User.HasClaim("IsSuperAdmin", "true"))
                {
                    <span class="badge bg-warning text-dark">Süper Admin</span>
                }
                else
                {
                    <span class="badge bg-primary">@(User.FindFirst("GroupId") != null ? "Grup Üyesi" : "Grup Yok")</span>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>Şifre Değiştir</h6>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                }
                <form method="post" asp-action="ChangePassword">
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Mevcut Şifre</label>
                        <input asp-for="CurrentPassword" class="form-control" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrar</label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Şifreyi Güncelle
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@model CreateSprintViewModel
@{
    ViewData["Title"] = "Yeni Sprint";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Sprints/Index">Sprintler</a></li>
                <li class="breadcrumb-item active">Yeni Sprint</li>
            </ol>
        </nav>
        <h2 class="page-title mb-0"><i class="bi bi-lightning-charge me-2 text-primary"></i>Yeni Sprint Oluştur</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post" asp-action="Create">
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-medium">Sprint Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Örn: Sprint 12 – Hafta 1" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectId" class="form-label fw-medium">Proje <span class="text-danger">*</span></label>
                        <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                            <option value="">Proje Seçin</option>
                        </select>
                        <span asp-validation-for="ProjectId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Goal" class="form-label fw-medium">Sprint Hedefi</label>
                        <textarea asp-for="Goal" class="form-control" rows="3"
                                  placeholder="Bu 1 haftada neyi bitirmeyi hedefliyoruz?"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-medium">Başlangıç <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" id="startDate" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-medium">Bitiş <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control" id="endDate" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mt-2">
                        <i class="bi bi-info-circle me-1"></i>Bitiş tarihi otomatik olarak başlangıçtan <strong>1 hafta sonra</strong> ayarlanır. İstersen değiştirebilirsin.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-2"></i>Sprint Oluştur
                        </button>
                        <a href="/Sprints/Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const startEl = document.getElementById('startDate');
    const endEl = document.getElementById('endDate');
    // Başlangıç değişince bitişi otomatik +7 gün yap
    startEl.addEventListener('change', function () {
        if (!startEl.value) return;
        const d = new Date(startEl.value);
        d.setDate(d.getDate() + 7);
        endEl.value = d.toISOString().slice(0, 10);
    });
</script>
}

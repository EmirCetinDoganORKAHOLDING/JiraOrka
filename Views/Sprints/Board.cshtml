@model SprintBoardViewModel
@{
    ViewData["Title"] = Model.Sprint.Name;
    var s = Model.Sprint;
    var canManage = Model.CanManage;
    var isActive = s.Status == SprintStatus.Active;
    var isPlanned = s.Status == SprintStatus.Planned;
    var isCompleted = s.Status == SprintStatus.Completed;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Sprints/Index">Sprintler</a></li>
                <li class="breadcrumb-item active">@s.Name</li>
            </ol>
        </nav>
        <h2 class="page-title mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-lightning-charge text-primary"></i>@s.Name
            <span class="badge @s.StatusClass align-middle">@s.StatusLabel</span>
        </h2>
    </div>
    <div class="d-flex gap-2">
        @if (canManage && isPlanned)
        {
            <form method="post" action="/Sprints/Start" class="m-0" onsubmit="return confirm('Sprinti başlatmak istediğinize emin misiniz?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-play-fill me-1"></i>Sprinti Başlat
                </button>
            </form>
        }
        @if (canManage && isActive)
        {
            <form method="post" action="/Sprints/Complete" class="m-0" onsubmit="return confirm('Sprinti tamamlamak istediğinize emin misiniz? Bitmemiş görevler backlog''a dönecek.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-flag-fill me-1"></i>Sprinti Tamamla
                </button>
            </form>
        }
    </div>
</div>

<!-- Sprint özet şeridi -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="row align-items-center g-3">
            <div class="col-md-4">
                <div class="text-muted small mb-1"><i class="bi bi-folder2 me-1"></i>Proje</div>
                <div class="fw-semibold">@s.ProjectName</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small mb-1"><i class="bi bi-calendar3 me-1"></i>Süre</div>
                <div class="fw-semibold">@s.StartDate.ToString("d MMM") – @s.EndDate.ToString("d MMM")</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small mb-1"><i class="bi bi-clock-history me-1"></i>Durum</div>
                <div class="fw-semibold">
                    @if (isActive)
                    {
                        <span class="@(s.DaysRemaining < 0 ? "text-danger" : (s.DaysRemaining <= 1 ? "text-warning" : "text-success"))">
                            @(s.DaysRemaining < 0 ? $"{-s.DaysRemaining} gün gecikme" : $"{s.DaysRemaining} gün kaldı")
                        </span>
                    }
                    else if (isPlanned)
                    {
                        <span class="text-muted">Başlamadı</span>
                    }
                    else
                    {
                        <span class="text-muted">Kapandı</span>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">İlerleme (@s.DoneTaskCount/@Model.TotalTasks)</span>
                    <span class="fw-medium">%@(Model.TotalTasks == 0 ? 0 : (int)Math.Round(Model.DoneTasks.Count * 100.0 / Model.TotalTasks))</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar @(isCompleted ? "bg-primary" : "bg-success")"
                         style="width: @(Model.TotalTasks == 0 ? 0 : (int)Math.Round(Model.DoneTasks.Count * 100.0 / Model.TotalTasks))%"></div>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(s.Goal))
        {
            <div class="mt-3 pt-3 border-top text-muted small">
                <i class="bi bi-bullseye me-1"></i><strong>Hedef:</strong> @s.Goal
            </div>
        }
    </div>
</div>

<div class="row g-3">
    <!-- Sprint kanban -->
    <div class="col-lg-@(isCompleted ? 12 : 9)">
        <div class="kanban-board" id="kanban-board" data-project-id="@s.ProjectId">
            @{
                var columns = new[]
                {
                    ("todo", "Yapılacak", "bi-circle", "col-todo", Model.TodoTasks, 0),
                    ("inprogress", "Devam Ediyor", "bi-arrow-clockwise", "col-inprogress", Model.InProgressTasks, 1),
                    ("inreview", "İncelemede", "bi-eye", "col-inreview", Model.InReviewTasks, 2),
                    ("done", "Tamamlandı", "bi-check-circle", "col-done", Model.DoneTasks, 3)
                };
            }
            @foreach (var (id, label, icon, cssClass, tasks, statusInt) in columns)
            {
                <div class="kanban-column @cssClass">
                    <div class="kanban-column-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @icon"></i>
                            <span class="column-title">@label</span>
                            <span class="badge bg-secondary rounded-pill">@tasks.Count</span>
                        </div>
                    </div>
                    <div class="kanban-column-body sortable-list" data-status="@statusInt" id="col-@id">
                        @foreach (var task in tasks)
                        {
                            <div class="task-card" data-task-id="@task.Id">
                                <div class="task-card-header">
                                    <span class="priority-badge @task.PriorityClass">@task.PriorityLabel</span>
                                    <div class="d-flex align-items-center gap-1">
                                        <a href="/Tasks/Details/@task.Id" class="task-card-menu" title="Detay">
                                            <i class="bi bi-three-dots"></i>
                                        </a>
                                        @if (canManage && !isCompleted)
                                        {
                                            <button type="button" class="task-card-menu border-0 bg-transparent p-0 text-muted"
                                                    title="Backlog'a geri al" onclick="removeFromSprint(@task.Id)">
                                                <i class="bi bi-arrow-return-left"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <a href="/Tasks/Details/@task.Id" class="task-card-title">@task.Title</a>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <p class="task-card-desc">@(task.Description.Length > 80 ? task.Description.Substring(0, 80) + "..." : task.Description)</p>
                                }
                                <div class="task-card-footer">
                                    @if (!string.IsNullOrEmpty(task.AssignedToName))
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="assignee-avatar" title="@task.AssignedToName">
                                                @task.AssignedToName.FirstOrDefault().ToString().ToUpper()
                                            </div>
                                            <span class="text-muted small fw-medium">@task.AssignedToName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-person-x me-1"></i>Atanmadı</span>
                                    }
                                    <div class="task-card-meta">
                                        @if (task.DueDate.HasValue)
                                        {
                                            <span class="@(task.DueDate < DateTime.UtcNow && task.Status != Tezgah.Models.TaskStatus.Done ? "text-danger" : "text-muted") small">
                                                <i class="bi bi-calendar3"></i> @task.DueDate.Value.ToString("d MMM")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Backlog paneli -->
    @if (!isCompleted)
    {
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-inbox me-2 text-secondary"></i>Backlog</h6>
                    <div class="text-muted small">Projedeki sprint'siz görevler</div>
                </div>
                <div class="card-body pt-2" style="max-height: 70vh; overflow-y: auto;">
                    @if (!Model.BacklogTasks.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-check2-circle d-block mb-2" style="font-size:1.5rem;"></i>
                            Backlog boş
                        </div>
                    }
                    else
                    {
                        @foreach (var task in Model.BacklogTasks)
                        {
                            <div class="border rounded p-2 mb-2 backlog-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <a href="/Tasks/Details/@task.Id" class="text-decoration-none text-dark small fw-medium">@task.Title</a>
                                    <span class="priority-badge @task.PriorityClass" style="flex-shrink:0;">@task.PriorityLabel</span>
                                </div>
                                @if (canManage)
                                {
                                    <form method="post" action="/Sprints/AddTask" class="mt-2 m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sprintId" value="@s.Id" />
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary w-100 py-1" style="font-size:11px;">
                                            <i class="bi bi-plus-lg me-1"></i>Sprint'e Ekle
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a href="/Tasks/Create?projectId=@s.ProjectId" class="btn btn-sm btn-light w-100">
                        <i class="bi bi-plus-circle me-1"></i>Yeni Görev
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (canManage)
{
    <form id="removeFromSprintForm" method="post" action="/Sprints/RemoveTask" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="sprintId" value="@s.Id" />
        <input type="hidden" name="taskId" id="removeTaskId" />
    </form>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const lists = document.querySelectorAll('.sortable-list');
    lists.forEach(list => {
        Sortable.create(list, {
            group: 'kanban',
            animation: 200,
            ghostClass: 'task-card-ghost',
            dragClass: 'task-card-dragging',
            handle: '.task-card',
            onEnd: async function(evt) {
                const taskId = evt.item.dataset.taskId;
                const newStatus = evt.to.dataset.status;
                try {
                    const response = await fetch('/Tasks/UpdateStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: JSON.stringify({ taskId: parseInt(taskId), status: parseInt(newStatus) })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showToast('Durum güncellenemedi: ' + result.message, 'error');
                        evt.from.insertBefore(evt.item, evt.from.children[evt.oldIndex]);
                    } else {
                        updateColumnCounts();
                        showToast('Görev durumu güncellendi', 'success');
                    }
                } catch (err) {
                    showToast('Bağlantı hatası', 'error');
                    evt.from.insertBefore(evt.item, evt.from.children[evt.oldIndex]);
                }
            }
        });
    });

    function updateColumnCounts() {
        document.querySelectorAll('.kanban-column').forEach(col => {
            const count = col.querySelectorAll('.task-card').length;
            const badge = col.querySelector('.badge');
            if (badge) badge.textContent = count;
        });
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `toast-notification toast-${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>${message}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 3000);
    }
});

function getAntiForgeryToken() {
    const input = document.querySelector('input[name="__RequestVerificationToken"]');
    return input ? input.value : '';
}

function removeFromSprint(taskId) {
    document.getElementById('removeTaskId').value = taskId;
    document.getElementById('removeFromSprintForm').submit();
}
</script>
}

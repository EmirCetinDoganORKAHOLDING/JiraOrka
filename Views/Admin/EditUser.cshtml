@model EditUserViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Admin/Users">Kullanıcılar</a></li>
                <li class="breadcrumb-item active">Düzenle</li>
            </ol>
        </nav>
        <h2 class="page-title mb-0"><i class="bi bi-person-gear me-2 text-primary"></i>Kullanıcı Düzenle</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post" asp-action="EditUser">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-medium">Ad Soyad</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-medium">Kullanıcı Adı</label>
                            <div class="input-group">
                                <span class="input-group-text">@@</span>
                                <input asp-for="Username" class="form-control" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-medium">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewPassword" class="form-label fw-medium">
                                Yeni Şifre <span class="text-muted small fw-normal">(Boş bırakırsanız değişmez)</span>
                            </label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Şifre değiştirmek için doldurun" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="GroupId" class="form-label fw-medium">Yetki Grubu</label>
                            <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                                <option value="">Grup Yok</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end gap-3 pb-1 flex-wrap">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Aktif</label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="IsSuperAdmin" class="form-check-input" type="checkbox" />
                                <label asp-for="IsSuperAdmin" class="form-check-label text-warning fw-semibold">
                                    <i class="bi bi-star-fill me-1"></i>Süper Admin
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Güncelle
                        </button>
                        <a href="/Admin/Users" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

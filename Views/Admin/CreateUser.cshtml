@model CreateUserViewModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Admin/Users">Kullanıcılar</a></li>
                <li class="breadcrumb-item active">Yeni Kullanıcı</li>
            </ol>
        </nav>
        <h2 class="page-title mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Yeni Kullanıcı Ekle</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post" asp-action="CreateUser">
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-medium">Ad Soyad</label>
                            <input asp-for="FullName" class="form-control" placeholder="Ahmet Yılmaz" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-medium">Kullanıcı Adı</label>
                            <div class="input-group">
                               <span class="input-group-text">&#64;</span>
                                <input asp-for="Username" class="form-control" placeholder="ahmetyilmaz" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-medium">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="ahmet@ornek.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-medium">Şifre</label>
                            <input asp-for="Password" class="form-control" placeholder="En az 6 karakter" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GroupId" class="form-label fw-medium">Yetki Grubu</label>
                            <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                                <option value="">Grup Seçin (Opsiyonel)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">Aktif kullanıcı</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Kullanıcı Oluştur
                        </button>
                        <a href="/Admin/Users" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

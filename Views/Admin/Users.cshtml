@model IEnumerable<AppUser>
@{
    ViewData["Title"] = "Kullanıcılar";
    var users = Model.ToList();
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
}

<div class="page-header">
    <h2 class="page-title"><i class="bi bi-people me-2 text-primary"></i>Kullanıcı Yönetimi</h2>
    <a href="/Admin/CreateUser" class="btn btn-primary">
        <i class="bi bi-person-plus me-2"></i>Yeni Kullanıcı
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!users.Any())
        {
            <div class="empty-state p-5">
                <i class="bi bi-people"></i>
                <p>Henüz kullanıcı yok</p>
                <a href="/Admin/CreateUser" class="btn btn-primary btn-sm">Kullanıcı Ekle</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Kullanıcı</th>
                            <th>Email</th>
                            <th>Yetki Grubu</th>
                            <th>Durum</th>
                            <th>Kayıt</th>
                            <th class="text-end pe-4">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="table-avatar @(user.IsSuperAdmin ? "bg-warning text-dark" : "")">
                                            @user.FullName.FirstOrDefault().ToString().ToUpper()
                                        </div>
                                        <div>
                                            <a href="/Admin/UserDetail/@user.Id" class="fw-semibold text-decoration-none text-dark">@user.FullName</a>
                                            <div class="text-muted small">@@@user.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.IsSuperAdmin)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Süper Admin</span>
                                    }
                                    else if (!string.IsNullOrEmpty(user.GroupName))
                                    {
                                        <span class="badge bg-primary-soft text-primary">@user.GroupName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Grup yok</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-soft text-success"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-soft text-danger"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Pasif</span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("d MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    @if (user.Id == currentUserId)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    else
                                    {
                                        <a href="/Admin/EditUser/@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="confirmDelete(@user.Id, '@user.FullName')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Kullanıcıyı Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong id="deleteUserName"></strong> adlı kullanıcıyı silmek istediğinize emin misiniz?</p>
                <p class="text-muted small">Bu işlem geri alınamaz.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, name) {
    document.getElementById('deleteUserName').textContent = name;
    document.getElementById('deleteForm').action = '/Admin/DeleteUser/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
}
